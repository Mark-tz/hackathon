[Unit]
Description=OJ HTTP Server (调度黑客松)
After=network.target

[Service]
Type=simple
User=oj
Group=oj
WorkingDirectory=/home/hackerson
EnvironmentFile=/etc/oj.env
ExecStart=/usr/bin/python3 /home/hackerson/oj/server.py
Restart=on-failure
RestartSec=3
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hackerson/oj
PrivateTmp=true

[Install]
WantedBy=multi-user.target
