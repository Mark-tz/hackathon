# OJ 环境变量配置文件
# 复制到 /etc/oj.env 并按需修改
# 权限建议：chmod 640 /etc/oj.env && chown root:oj /etc/oj.env

# ── 必改项 ────────────────────────────────────────────────
# 管理员密钥（用于 POST /admin/team），设为随机字符串
OJ_ADMIN=请改成随机字符串

# ── 可选项 ────────────────────────────────────────────────
# HTTP 监听端口（默认 8080）
OJ_PORT=8080

# 当前赛制阶段：A（初赛）或 B（决赛）
OJ_PHASE=A

# 数据库路径（默认 oj/oj.db，相对于 WorkingDirectory）
# OJ_DB=/home/hackerson/oj/oj.db

# 评测超时秒数（默认 150）
# OJ_EVAL_TIMEOUT=150
