# OJ 环境变量配置文件
# 复制到 /etc/oj.env 并按需修改
# 权限建议：chmod 640 /etc/oj.env && chown root:oj /etc/oj.env

# ── 必改项 ────────────────────────────────────────────────
# 管理员密钥：在网页登录框输入即进入管理界面。至少 12 位随机字符串，
# 保持占位值时管理员登录被禁用。生成：openssl rand -hex 24
OJ_ADMIN=请改成随机字符串

# ── 可选项 ────────────────────────────────────────────────
# HTTP 监听端口（默认 8080，部署建议 8088 避开常见占用）
OJ_PORT=8088

# 数据库路径（默认 oj/oj.db，相对于 WorkingDirectory）
# OJ_DB=/home/hackerson/oj/oj.db

# 评测超时秒数（默认 150）
# OJ_EVAL_TIMEOUT=150
